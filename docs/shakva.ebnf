(*
 * The syntax is specified using a [variant](https://en.wikipedia.org/wiki/Wirth_syntax_notation) of Extended Backus-Naur Form (EBNF):
 *
 * ```ebnf
 *  syntax      = { production } .
 *  production  = ProductionName "=" [ expression ] "." .
 *  expression  = term { "|" term } .
 *  term        = factor { factor } .
 *  factor      = ProductionName
 *              | Token
 *              | group
 *              | option
 *              | repetition .
 *
 *  group       = "(" expression ")" .
 *  option      = "[" expression "]" .
 *  repetition  = "{" expression "}" .
 * ```
 *
 * SNAKE_UPPER_CASE production names are used to identify lexical (terminal) tokens. 
 * Non-terminals are in snake_case. Lexical tokens are enclosed in double quotes "".
 *)

shakva_file = [ stmts ] .

stmts = stmt { ";" stmt } [ ";" ] .

stmt = assign
     | bind
     | expr .

assign      = IDENT assign_op expr .

assign_op = "="
          | "+="
          | "-="
          | "*="
          | "/="
          | "%="
          | "**="
          | "//=" .

bind  = [ "mut" ] IDENT ":=" expr .

expr         = or_expr .
(* 
 * `or`, `and` and arithmetic repetitions are left associative. 
 * Comparisons form one chain. 
 *)
or_expr      = and_expr { "or" and_expr } .
and_expr     = compare_expr { "and" compare_expr } .
compare_expr = add_expr { ( ">" | "<" | "==" | ">=" | "<=" ) add_expr } .
add_expr     = mul_expr { ( "+" | "-" ) mul_expr } .
mul_expr     = neg_expr { ( "*" | "/" | "//" | "%" ) neg_expr } .
neg_expr     = "-" neg_expr | not_expr | power_expr .
not_expr     = "not" compare_expr .
power_expr   = call_expr [ "**" neg_expr ] .

paren_expr = "(" expr ")" .
lit_expr   = INT_LIT
           | FLOAT_LIT
           | STR_LIT .

ref_expr   = IDENT .

call_expr = callee call_suffix .
callee    = paren_expr
          | lit_expr
          | ref_expr
          | block_expr
          | lambda_expr
          | if_expr
          | match_expr
          | for_expr
          | while_expr
          | do_while_expr
          | loop_expr
          | break_expr
          | continue_expr .

(* The first lambda after a parenthesized argument list belongs to that call.
 * Each other lambda is a separate call. *)
call_suffix = { lambda_expr } { paren_args { lambda_expr } } .

paren_args = "(" [ expr { "," expr } [ "," ]] ")" .

block_expr = "{" [ stmts ] "}" .

if_expr     = if_branch { elif_branch } [ else_branch ] .
if_branch   = "if" expr block_expr .
elif_branch = "elif" expr block_expr .
else_branch = "else" block_expr .

lambda_expr   = "{" [ lambda_params ] "=>" [ stmts ] "}" .
lambda_params = IDENT { "," IDENT } [ "," ] .

(* For each `match` in source order, use the first `{` that can start its arms
 * and still let the whole file parse. *)
match_expr = "match" scrutinee "{" match_arms "}" .
scrutinee  = expr .
match_arms = match_arm { ";" match_arm } [ ";" ] .
match_arm  = pat [ guard ] "=>" expr .

pat   = IDENT | [ "-" ] INT_LIT .
guard = "if" expr .

for_expr      = "for" pat "in" expr [ guard ] block_expr .
while_expr    = "while" expr block_expr .
(* Resolve `match` arms first. Then read `not` and `break` operands and
 * `do ... while` conditions from left to right. For each, take the longest
 * expression that still lets the whole file parse. *)
do_while_expr = "do" block_expr "while" expr .
loop_expr     = "loop" block_expr .

break_expr    = "break" [ expr ] .
continue_expr = "continue" .
