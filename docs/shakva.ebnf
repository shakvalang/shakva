(*
 * The syntax is specified using a [variant](https://en.wikipedia.org/wiki/Wirth_syntax_notation) of Extended Backus-Naur Form (EBNF):
 *
 * ```ebnf
 *  syntax      = { production } .
 *  production  = PRODUCTION_NAME "=" [ expression ] "." .
 *  expression  = term { "|" term } .
 *  term        = factor { factor } .
 *  factor      = PRODUCTION_NAME
 *              | TOKEN
 *              | group
 *              | option
 *              | repetition .
 *
 *  group       = "(" expression ")" .
 *  option      = "[" expression "]" .
 *  repetition  = "{" expression "}" .
 * ```
 *
 * SNAKE_UPPER_CASE production names are used to identify lexical (terminal) tokens. 
 * Non-terminals are in snake_case. Lexical tokens are enclosed in double quotes "".
 *)

shakva_file = [ stmts ] .

stmts = stmt { ";" stmt } [ ";" ] .

stmt = assign
     | bind
     | expr .

assign    = IDENT assign_op expr .
assign_op = "="
          | "+="
          | "-="
          | "*="
          | "/="
          | "%="
          | "**="
          | "//=" .

bind = IDENT ":=" expr .

expr         = or_expr .
(* Repeated `or`, `and`, additive and multiplicative operators associate left. Comparisons form a single chain. *)
or_expr      = and_expr { "or" and_expr } .
and_expr     = not_expr { "and" not_expr } .
not_expr     = "not" not_expr | compare_expr .
compare_expr = add_expr { ( ">" | "<" | "==" | ">=" | "<=" ) add_expr } .
add_expr     = mul_expr { ( "+" | "-" ) mul_expr } .
mul_expr     = neg_expr { ( "*" | "/" | "//" | "%" ) neg_expr } .
neg_expr     = "-" neg_expr | power_expr .
power_expr   = call_expr [ "**" neg_expr ] .

paren_expr = "(" expr ")" .
lit_expr   = INT_LIT
           | FLOAT_LIT
           | STR_LIT 
           | "true" 
           | "false" .

ref_expr   = IDENT .

call_expr = callee call_suffix .
callee    = paren_expr
          | lit_expr
          | ref_expr
          | block_expr
          | lambda_expr
          | if_expr
          | match_expr
          | for_expr
          | while_expr
          | do_while_expr
          | loop_expr
          | break_expr
          | continue_expr .

(* A lambda immediately after paren_args joins that call. Each other trailing lambda starts a call. *)
call_suffix = { lambda_expr } { paren_args { lambda_expr } } .

paren_args = "(" [ expr { "," expr } [ "," ]] ")" .

block_expr = "{" [ stmts ] "}" .

if_expr     = if_branch { elif_branch } [ else_branch ] .
if_branch   = "if" expr block_expr .
elif_branch = "elif" expr block_expr .
else_branch = "else" block_expr .

lambda_expr   = "{" [ lambda_params ] "=>" [ stmts ] "}" .
lambda_params = IDENT { "," IDENT } [ "," ] .

match_expr = "match" scrutinee "{" match_arms "}" .
(* At each scrutinee's outermost delimiter depth, call_suffix = { paren_args }. *)
scrutinee  = expr .
match_arms = match_arm { ";" match_arm } [ ";" ] .
match_arm  = pat [ guard ] "=>" expr .

pat   = IDENT | [ "-" ] INT_LIT .
guard = "if" expr .

for_expr      = "for" pat "in" expr [ guard ] block_expr .
while_expr    = "while" expr block_expr .
(* 
 * In source order, give each break operand and do-while condition the longest
 * expression that lets the whole file parse. 
 *)
do_while_expr = "do" block_expr "while" expr .
loop_expr     = "loop" block_expr .

break_expr    = "break" [ expr ] .
continue_expr = "continue" .
