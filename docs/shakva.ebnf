(*
 * The syntax is specified using a [variant](https://en.wikipedia.org/wiki/Wirth_syntax_notation) of Extended Backus-Naur Form (EBNF):
 *
 * ```ebnf
 *  syntax      = { production } .
 *  production  = PRODUCTION_NAME "=" [ expression ] "." .
 *  expression  = term { "|" term } .
 *  term        = factor { factor } .
 *  factor      = PRODUCTION_NAME
 *              | TOKEN
 *              | group
 *              | option
 *              | repetition .
 *
 *  group       = "(" expression ")" .
 *  option      = "[" expression "]" .
 *  repetition  = "{" expression "}" .
 * ```
 *
 * SNAKE_UPPER_CASE production names are used to identify lexical (terminal) tokens. 
 * Non-terminals are in snake_case. Lexical tokens are enclosed in double quotes "".
 * 
 * A newline may replace ";" between expressions or match arms.
 * No newline may precede an infix, binding or assignment operator, or any call suffix.
 *)

shakva_file = [ exprs ] .

exprs = expr { ";" expr } [ ";" ] .

expr = assign | bind | or_expr .

assign    = IDENT assign_op expr .
assign_op = "="
          | "+="
          | "-="
          | "*="
          | "/="
          | "%="
          | "**="
          | "//=" .

bind = IDENT ":=" expr .

(* or, and, additive and multiplicative operators associate left. Comparisons chain. *)
or_expr      = and_expr { "or" and_expr } .
and_expr     = not_expr { "and" not_expr } .
not_expr     = "not" not_expr | compare_expr .
compare_expr = add_expr { compare_op add_expr } .
compare_op   = ">" | "<" | "==" | ">=" | "<=" .
add_expr     = mul_expr { ( "+" | "-" ) mul_expr } .
mul_expr     = neg_expr { ( "*" | "/" | "//" | "%" ) neg_expr } .
neg_expr     = "-" neg_expr | power_expr .
power_expr   = call_expr [ "**" neg_expr ] .

paren_expr = "(" expr ")" .
lit_expr   = INT_LIT
           | FLOAT_LIT
           | STR_LIT 
           | "true" 
           | "false" .

ref_expr   = IDENT .

call_expr = callee call_suffix .
callee    = paren_expr
          | lit_expr
          | ref_expr
          | lambda_expr
          | if_expr
          | match_expr
          | for_expr
          | while_expr
          | do_while_expr
          | loop_expr
          | break_expr
          | continue_expr
          | return_expr
          | try_expr
          | throw_expr .

(* A trailing lambda joins the call immediately after paren_args; otherwise it starts a call. *)
call_suffix = { lambda_expr } { paren_args { lambda_expr } } .

paren_args = "(" [ expr { "," expr } [ "," ]] ")" .

body = "{" [ exprs ] "}" .

if_expr     = if_branch { elif_branch } [ else_branch ] .
if_branch   = "if" expr body .
elif_branch = "elif" expr body .
else_branch = "else" body .

lambda_expr   = "{" [ lambda_params ] "=>" [ exprs ] "}" .
lambda_params = IDENT { "," IDENT } [ "," ] .

match_expr = "match" scrutinee "{" match_arms "}" .
(* At the scrutinee's outermost depth, call_suffix = { paren_args }. *)
scrutinee  = expr .
match_arms = match_arm { ";" match_arm } [ ";" ] .
match_arm  = pat [ guard ] "=>" arm_body .
(* After an arm's =>, a leading "{" opens the arm body. *)
arm_body   = expr | body .

pat   = IDENT | [ "-" ] INT_LIT .
guard = "if" expr .

for_expr      = "for" pat "in" expr [ guard ] body .
while_expr    = "while" expr body .
(* In source order, choose the longest break/return/throw operand or do-while condition that lets the whole file parse. *)
do_while_expr = "do" body "while" expr .
loop_expr     = "loop" body .

continue_expr = "continue" .
(* A break, return, or throw operand must start on the keyword's line. *)
break_expr    = "break" [ expr ] .
return_expr   = "return" [ expr ] .
throw_expr    = "throw" expr .

try_expr       = "try" body ( catches [ finally_clause ] | finally_clause ) .
catches        = catch_clause { catch_clause } .
catch_clause   = "catch" pat body .
finally_clause = "finally" body .
