// The shape of every node the Shakva parser makes: which children it has, in what order. 
// `shakva generate syntax <syntax_codegen.toml>` makes the node kinds of it, 
// and the typed views of `shakva::syntax::ast`. 
// It is an ungrammar:
//
//   Node = Rule          a node, or an enum of nodes if the rule only lists nodes: `Expr = BinExpr | ...`
//   'text'               a token spelled so; `'Ident'`, a token of that kind; `'AnyToken'`, any token at all
//   A B, A | B           a sequence, alternatives
//   A?, A*, (A)          optional, repeated, grouped
//   label:A              names what an accessor returns; in an enum, the variant

ShakvaFile =
  Statements

Statements =
  (Statement? (';' | 'NL'))* Statement?

Statement =
  Binding
| Assignment
| Expr

Binding =
  modifier: 'mut'? name: 'Ident' ':=' value: Expr

Assignment =
  target: RefExpr 
  op: ('=' | '+=' | '-=' | '*=' | '/=' | '%=' | '**=' | '//=') 
  value: Expr

Expr =
  BinaryExpr
| ParenExpr
| LitExpr
| RefExpr
| CallExpr
| BlockExpr
| IfExpr
| LambdaExpr
| PrefixExpr
| MatchExpr

BinaryExpr =
  lhs: Expr 
  op: ('+' | '-' | '*' | '/' | '%' | '**' | '//' | '>' | '<' | '==' | '>=' | '<=') 
  rhs: Expr

ParenExpr = 
  '(' Expr ')'

LitExpr = 
  'IntLit' 
| 'FloatLit'

RefExpr =
  name: 'Ident'

CallExpr =
  callee: Expr CallSuffix

CallSuffix =
  ParenArgs trailing_lambda: LambdaExpr?
| trailing_lambda: LambdaExpr

ParenArgs =
  '(' (Expr (',' Expr)* ','?)? ')'

BlockExpr =
  '{' body: Statements '}'

IfExpr =
  IfBranch ElifBranch* ElseBranch?

IfBranch =
  'if' cond: Expr body: BlockExpr

ElifBranch =
  'elif' cond: Expr body: BlockExpr

ElseBranch =
  'else' body: BlockExpr

LambdaExpr =
  '{' LambdaParams? '=>' body: Statements '}'

LambdaParams =
  'Ident' (',' 'Ident')* ','?

PrefixExpr =
  op: ('-' | '!') rhs: Expr

MatchExpr =
  'match' scrutinee: Expr '{' MatchArm (',' MatchArm)* ','? '}'

MatchArm =
  pattern: MatchPattern '=>' body: Expr

MatchPattern =
  '-'? 'IntLit'
| '_'
